    {
      "id": "s4",
      "concept": "Corrosion rate formula",
      "narration": "The corrosion rate (CPR) is calculated using CPR = k times W / (ρ times A times T). Here, k is a constant, W is weight loss, ρ is density, A is area, and T is time in hours.",
      "board": [
        {
          "id": "auto_clear_s4",
          "duration_ms": 120,
          "start": {
            "sentence": 0,
            "char": 0
          },
          "op": "clear"
        },
        {
          "id": "a12",
          "duration_ms": 800,
          "start": null,
          "op": "write_math",
          "latex": "CPR = \\frac{k \\cdot W}{\\rho \\cdot A \\cdot T}",
          "region": "auto",
          "rect": {
