      "id": "s5",
      "concept": "Calculate CPR for brass and steel",
      "narration": "For a brass pipe with 0.5g weight loss, density 8.5g/cm^3, area 10cm^2, and time 1000 hours, use CPR = k times W/(ρ times A times T). With k=100, CPR = 100 times 0.5/(8.5 times 10 times 1000) = 0.000588 mm/year.",
      "board": [
        {
          "id": "a16",
          "duration_ms": 800,
          "start": null,
          "op": "write_math",
          "latex": "CPR = \\frac{100 \\cdot 0.5}{8.5 \\cdot 10 \\cdot 1000}",
          "region": "auto",
