      "checkpoint": null
    },
    {
      "id": "s4",
      "concept": "apply to a real problem",
      "narration": "If a ladder is 10 feet long and leans against a wall with its base 6 feet from the wall, how high does it reach? Use c = 10, a = 6, then b^2 = c^2 - a^2 = 100 - 36 = 64, so b = 8 feet.",
