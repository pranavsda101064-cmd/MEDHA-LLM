    {
      "id": "s2",
      "concept": "electrochemical theory of corrosion",
      "narration": "Electrochemical corrosion occurs when metals are exposed to water and oxygen. In iron, this creates an anode and a cathode on the surface. The anode loses electrons and forms iron ions, while oxygen at the cathode accepts electrons and forms hydroxide ions.",
      "board": [
        {
          "id": "a3",
          "duration_ms": 800,
          "start": null,
          "op": "write_math",
          "latex": "Fe \\rightarrow Fe^{2+} + 2e^-",
          "region": "auto",
          "rect": {
            "x": 0.06,
            "y": 0.38,
            "w": 0.4,
            "h": 0.14
          },
          "font_size": 1.4,
          "color": "math",
          "speed": 0.06
        },
        {
          "id": "a4",
          "duration_ms": 800,
          "start": null,
          "op": "write_math",
          "latex": "O_2 + 2H_2O + 4e^- \\rightarrow 4OH^-",
          "region": "auto",
          "rect": {
            "x": 0.54,
            "y": 0.38,
            "w": 0.36,
            "h": 0.14
          },
          "font_size": 1.4,
          "color": "math",
          "speed": 0.06
        }
      ],
      "checkpoint": null
    },
    {
      "id": "s3",
      "concept": "formation of rust",
      "narration": "Iron ions react with hydroxide ions to form iron hydroxide, which then oxidizes in the presence of oxygen and water to form rust. Rust is hydrated iron(III) oxide, Fe₂O₃ * nH₂O. This process happens slowly over time in humid air.",
      "board": [
        {
          "id": "a5",
          "duration_ms": 800,
          "start": null,
          "op": "write_math",
          "latex": "2Fe^{2+} + 4OH^- \\rightarrow 2Fe(OH)_2",
          "region": "auto",
          "rect": {
            "x": 0.06,
            "y": 0.54,
            "w": 0.4,
            "h": 0.14
          },
          "font_size": 1.4,
          "color": "math",
          "speed": 0.06
        },
        {
          "id": "a6",
          "duration_ms": 800,
          "start": null,
          "op": "write_math",
          "latex": "2Fe(OH)_2 + O_2 + nH_2O \\rightarrow Fe_2O_3 \\cdot nH_2O",
          "region": "auto",
          "rect": {
            "x": 0.54,
            "y": 0.54,
            "w": 0.36,
            "h": 0.14
          },
          "font_size": 1.4,
          "color": "math",
          "speed": 0.06
        }
      ],
      "checkpoint": null
    },
    {
      "id": "s4",
      "concept": "black rust formation",
      "narration": "When oxygen is limited, iron hydroxide forms black rust, Fe₃O₄ * 3H₂O. This occurs in sealed or low-oxygen environments, like under oil or in damp crevices. The reaction is slower and produces a darker, less stable product.",
      "board": [
        {
          "id": "a7",
          "duration_ms": 800,
          "start": null,
          "op": "write_math",
          "latex": "3Fe(OH)_2 + \\frac{1}{2}O_2 \\rightarrow Fe_3O_4 \\cdot 3H_2O",
          "region": "auto",
          "rect": {
